# Copy to .env and fill in. Never commit .env.
PORT=8080
HOST=127.0.0.1   # behind nginx/Caddy; use 0.0.0.0 only for local testing
TZ=Asia/Kolkata
SESSION_DAYS=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=loan_recovery
DB_USER=recovery
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# Updates from the overlord console (Update & diagnostics).
# Public key that signed update packages must match: run `node scripts/patch.js keygen` on the release PC.
UPDATE_PUBLIC_KEY=
# Folder holding mariadb-dump / mariadb, if they are not on the PATH (Windows installer sets this).
# DB_BIN_DIR=C:\Program Files\MariaDB 11.8\bin
